---
import UserMenu from '../components/auth/UserMenu';
import NotificationBell from '../components/dashboard/NotificationBell';
import { canAccessRoute, ROLE_LABELS } from '../lib/permissions';
import { getDb } from '../db/client';
import { getAlerts, getVehicles } from '../db/queries';
import { Truck, Menu, LayoutDashboard, MapPin, Users, Route, Wrench, Fuel, Bell, CheckCircle, Map, FileText, BarChart3, UserCog } from 'lucide-react';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const user = Astro.locals.user;
const userRole = user?.role ?? 'admin';

let alertsForBell: any[] = [];
try {
  const db = getDb(Astro.locals.runtime.env.DB);
  const alerts = await getAlerts(db);
  const vehicles = await getVehicles(db);
  const vById = Object.fromEntries(vehicles.map((v) => [v.id, v]));
  alertsForBell = alerts.map((a) => ({ ...a, vehiclePlate: vById[a.vehicleId]?.plate }));
} catch {
  // ignore
}

const menuItems = [
  { label: 'Dashboard', href: '/app/dashboard', icon: LayoutDashboard },
  { label: 'Veículos', href: '/app/vehicles', icon: MapPin },
  { label: 'Motoristas', href: '/app/drivers', icon: Users },
  { label: 'Rotas', href: '/app/routes', icon: Route },
  { label: 'Manutenção', href: '/app/maintenance', icon: Wrench },
  { label: 'Combustível', href: '/app/fuel', icon: Fuel },
  { label: 'Alertas', href: '/app/alerts', icon: Bell },
  { label: 'Inspeções', href: '/app/inspections', icon: CheckCircle },
  { label: 'Geofences', href: '/app/geofences', icon: Map },
  { label: 'Relatórios', href: '/app/reports', icon: BarChart3 },
  { label: 'Usuários', href: '/app/users', icon: UserCog },
];

const menu = menuItems.filter((item) => canAccessRoute(userRole, item.href));

const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Frotamais</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Painel de gestão de frotas Frotamais." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1E3A8A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-brand-bg text-brand-text font-sans">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-brand-primary focus:text-white focus:px-4 focus:py-2 rounded">Pular para o conteúdo principal</a>

    <div class="flex min-h-screen">
      <aside
        class="w-64 bg-white border-r border-brand-border hidden md:flex flex-col fixed md:static inset-y-0 left-0 z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-200"
        id="app-sidebar"
      >
        <a href="/" class="flex items-center gap-2 px-6 h-16 font-extrabold text-xl text-brand-primary border-b border-brand-border">
          <Truck class="w-7 h-7" aria-hidden="true" />
          Frotamais
        </a>
        <nav class="flex-1 p-4 space-y-1 overflow-y-auto" aria-label="Principal">
          {menu.map((item) => {
            const Icon = item.icon;
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={`block px-4 py-3 rounded-xl text-sm font-medium transition min-h-12 flex items-center gap-3 ${
                  active
                    ? 'bg-brand-primary text-white shadow-md shadow-brand-primary/20'
                    : 'text-brand-text-secondary hover:bg-brand-bg hover:text-brand-text'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                <Icon class="w-5 h-5 flex-shrink-0" aria-hidden="true" />
                {item.label}
              </a>
            );
          })}
        </nav>
        <div class="p-4 border-t border-brand-border">
          {user && (
            <div class="mb-2">
              <span class="text-xs font-semibold text-brand-accent">{ROLE_LABELS[userRole] ?? 'Usuário'}</span>
            </div>
          )}
          <p class="text-xs text-brand-text-light">Dados ilustrativos — sem fins comerciais.</p>
        </div>
      </aside>

      <div
        class="fixed inset-0 bg-black/40 z-30 md:hidden hidden"
        id="sidebar-overlay"
      ></div>

      <main class="flex-1 min-w-0 md:ml-0">
        <div class="h-16 bg-white border-b border-brand-border flex items-center justify-between px-4 md:px-6 sticky top-0 z-20">
          <div class="flex items-center gap-3">
            <button
              type="button"
              class="md:hidden p-2 -ml-2 rounded-lg text-brand-text-secondary hover:bg-brand-bg"
              aria-label="Abrir menu"
              id="sidebar-toggle"
            >
              <Menu class="w-6 h-6" aria-hidden="true" />
            </button>
            <h1 class="font-bold text-lg">{title}</h1>
          </div>
          <div class="flex items-center gap-3">
            {alertsForBell.length > 0 && (
              <NotificationBell client:only="react" initialAlerts={alertsForBell} />
            )}
            {user ? (
              <UserMenu client:only="react" name={user.name} email={user.email} />
            ) : (
              <div class="w-9 h-9 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center font-bold text-sm">OP</div>
            )}
          </div>
        </div>
        <div id="conteudo" class="p-4 md:p-6">
          <slot />
        </div>
      </main>
    </div>

    <script is:inline>
      (function () {
        const btn = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('app-sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        if (!btn || !sidebar || !overlay) return;

        const open = () => {
          sidebar.classList.remove('hidden', 'md:flex');
          sidebar.classList.add('flex');
          sidebar.classList.remove('-translate-x-full');
          overlay.classList.remove('hidden');
        };

        const close = () => {
          sidebar.classList.add('-translate-x-full');
          overlay.classList.add('hidden');
          setTimeout(() => {
            sidebar.classList.add('hidden', 'md:flex');
            sidebar.classList.remove('flex');
          }, 200);
        };

        btn.addEventListener('click', open);
        overlay.addEventListener('click', close);
      })();
    </script>
  </body>
</html>
