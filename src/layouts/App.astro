---
import UserMenu from '../components/auth/UserMenu';
import NotificationBell from '../components/dashboard/NotificationBell';
import { canAccessRoute, ROLE_LABELS } from '../lib/permissions';
import { getDb } from '../db/client';
import { getAlerts, getVehicles } from '../db/queries';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const user = Astro.locals.user;
const userRole = user?.role ?? 'admin';

// Carrega alertas para o sino de notificacoes
let alertsForBell: any[] = [];
try {
  const db = getDb(Astro.locals.runtime.env.DB);
  const alerts = await getAlerts(db);
  const vehicles = await getVehicles(db);
  const vById = Object.fromEntries(vehicles.map((v) => [v.id, v]));
  alertsForBell = alerts.map((a) => ({ ...a, vehiclePlate: vById[a.vehicleId]?.plate }));
} catch {
  // ignore em paginas que nao precisam
}

const allMenu = [
  { label: 'Dashboard', href: '/app/dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { label: 'Veiculos', href: '/app/vehicles', icon: 'M3 8l9-5 9 5M3 8v10l9 5 9-5V8M3 8l9 5 9-5' },
  { label: 'Motoristas', href: '/app/drivers', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { label: 'Rotas', href: '/app/routes', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
  { label: 'Manutencao', href: '/app/maintenance', icon: 'M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.88-5.881m1.95 1.95l-2.265-2.265m-1.95 1.95l-2.265-2.265m-1.95 1.95l-2.265-2.265M14.24 6.76l-2.265 2.265m1.95 1.95l2.265-2.265M9.76 14.24l-2.265 2.265m1.95 1.95l2.265-2.265' },
  { label: 'Combustivel', href: '/app/fuel', icon: 'M3 4h18v6H3V4zm0 10h18v6H3v-6z' },
  { label: 'Alertas', href: '/app/alerts', icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9' },
  { label: 'Inspecoes', href: '/app/inspections', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { label: 'Geofences', href: '/app/geofences', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z' },
  { label: 'Relatorios', href: '/app/reports', icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { label: 'Usuarios', href: '/app/users', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
];

const menu = allMenu.filter((item) => canAccessRoute(userRole, item.href));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-brand-bg text-brand-text font-sans">
    <div class="flex min-h-screen">
      <aside class="w-64 bg-brand-surface border-r border-brand-border hidden md:flex flex-col">
        <a href="/" class="flex items-center gap-2 px-6 h-16 font-extrabold text-xl text-brand-primary border-b border-brand-border">
          <svg class="w-7 h-7" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M1 12c0 5.523 4.477 10 10 10s10-4.477 10-10S16.523 2 11 2 1 6.477 1 12Zm8.5 5V7h2v2.5a5.5 5.5 0 1 1 4.5 0V17h-2v-7.5a3.5 3.5 0 1 0-4.5 0V17h-2Z"/></svg>
          Frotamais
        </a>
        <nav class="flex-1 p-4 space-y-1 overflow-y-auto" aria-label="Principal">
          {menu.map((item) => (
            <a href={item.href} class={`block px-4 py-3 rounded-lg text-sm font-medium transition min-h-12 flex items-center gap-3 ${pathname === item.href || pathname.startsWith(item.href + '/') ? 'bg-brand-primary text-white' : 'text-brand-text-secondary hover:bg-brand-bg'}`}>
              <svg class="w-5 h-5 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="p-4 border-t border-brand-border">
          {user && (
            <div class="mb-2">
              <span class="text-xs font-semibold text-brand-accent">{ROLE_LABELS[userRole] ?? 'Usuario'}</span>
            </div>
          )}
          <p class="text-xs text-brand-text-light">Dados ilustrativos — sem fins comerciais.</p>
        </div>
      </aside>
      <main class="flex-1 min-w-0">
        <div class="h-16 bg-brand-surface border-b border-brand-border flex items-center justify-between px-4 md:px-6">
          <h1 class="font-bold text-lg">{title}</h1>
          <div class="flex items-center gap-3">
            {alertsForBell.length > 0 && (
              <NotificationBell client:only="react" initialAlerts={alertsForBell} />
            )}
            {user ? (
              <UserMenu client:only="react" name={user.name} email={user.email} />
            ) : (
              <div class="w-9 h-9 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center font-bold text-sm">OP</div>
            )}
          </div>
        </div>
        <div class="p-4 md:p-6">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
