---
import App from '../../layouts/App.astro';
import { getDb } from '../../db/client';
import { getVehicles, getDrivers } from '../../db/queries';
import VehiclesManager from '../../components/dashboard/VehiclesManager';

export const prerender = false;

const db = getDb(Astro.locals.runtime.env.DB);
const vehicles = await getVehicles(db);
const drivers = await getDrivers(db);
const driversById = Object.fromEntries(drivers.map((d) => [d.id, d]));

const vehiclesWithDriver = vehicles.map((v) => ({
  ...v,
  driverName: v.assignedDriverId ? driversById[v.assignedDriverId]?.name : null,
}));
---

<App title="Veiculos">
  <h2 class="text-xl font-bold text-brand-text mb-6">Frota completa</h2>
  <VehiclesManager client:only="react" initialVehicles={vehiclesWithDriver} />
</App>
