---
import { dateBR, fixPt, INSPECTION_TYPE_LABELS } from '../../lib/format';
import App from '../../layouts/App.astro';
import { getDb } from '../../db/client';
import { getInspections, getVehicles, getDrivers } from '../../db/queries';

export const prerender = false;

const db = getDb(Astro.locals.runtime.env.DB);
const inspections = await getInspections(db);
const vehicles = await getVehicles(db);
const drivers = await getDrivers(db);
const vehiclesById = Object.fromEntries(vehicles.map((v) => [v.id, v]));
const driversById = Object.fromEntries(drivers.map((d) => [d.id, d]));
---

<App title="Inspeções">
  <h2 class="text-2xl font-extrabold text-brand-text mb-2">Inspeções de veículos (DVIR)</h2>
  <p class="text-sm text-brand-text-secondary mb-6">Checklists pré e pós-viagem com registro de defeitos.</p>

  <div class="grid sm:grid-cols-3 gap-5 mb-8">
    <div class="bg-white rounded-2xl p-5 border border-brand-border shadow-sm">
      <p class="text-sm text-brand-text-secondary font-medium">Total de inspeções</p>
      <p class="text-2xl font-extrabold text-brand-text mt-2">{inspections.length}</p>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-brand-border shadow-sm">
      <p class="text-sm text-brand-text-secondary font-medium">Aprovadas</p>
      <p class="text-2xl font-extrabold text-brand-accent mt-2">{inspections.filter((i) => i.status === 'approved').length}</p>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-brand-border shadow-sm">
      <p class="text-sm text-brand-text-secondary font-medium">Com defeitos</p>
      <p class="text-2xl font-extrabold text-brand-warning mt-2">{inspections.filter((i) => i.status === 'failed').length}</p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-brand-border shadow-sm overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-brand-text-secondary border-b border-brand-border bg-brand-bg">
          <th class="px-6 py-3.5 font-semibold">Data</th>
          <th class="px-6 py-3.5 font-semibold">Veículo</th>
          <th class="px-6 py-3.5 font-semibold">Motorista</th>
          <th class="px-6 py-3.5 font-semibold">Tipo</th>
          <th class="px-6 py-3.5 font-semibold">Status</th>
          <th class="px-6 py-3.5 font-semibold">Defeitos</th>
        </tr>
      </thead>
      <tbody>
        {inspections.map((i) => (
          <tr class="border-b border-brand-border last:border-0 hover:bg-brand-bg/30 transition">
            <td class="px-6 py-3.5 text-brand-text-secondary">{dateBR(i.performedAt)}</td>
            <td class="px-6 py-3.5 font-semibold text-brand-text">{vehiclesById[i.vehicleId]?.plate ?? '-'}</td>
            <td class="px-6 py-3.5 text-brand-text-secondary">{driversById[i.driverId]?.name ?? '-'}</td>
            <td class="px-6 py-3.5 text-brand-text-secondary">{INSPECTION_TYPE_LABELS[i.type] ?? i.type}</td>
            <td class="px-6 py-3.5">
              <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${i.status === 'approved' ? 'bg-green-100 text-green-700' : i.status === 'failed' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700'}`}>
                {i.status === 'approved' ? 'Aprovada' : i.status === 'failed' ? 'Reprovada' : 'Pendente'}
              </span>
            </td>
            <td class="px-6 py-3.5 text-brand-text-secondary">{i.defects ?? '-'}</td>
          </tr>
        ))}
        {inspections.length === 0 && (
          <tr>
            <td colspan="6" class="px-6 py-10 text-center text-brand-text-secondary">Nenhuma inspeção registrada.</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</App>
