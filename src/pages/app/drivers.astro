---
import App from '../../layouts/App.astro';
import { getDb } from '../../db/client';
import { getDrivers, getSafetyEvents } from '../../db/queries';
import { calculateSafetyScore } from '../../lib/safety-score';
import DriversManager from '../../components/dashboard/DriversManager';

export const prerender = false;

const db = getDb(Astro.locals.runtime.env.DB);
const drivers = await getDrivers(db);
const allEvents = await getSafetyEvents(db);

const driversWithScore = drivers.map((d) => ({
  ...d,
  calculatedScore: calculateSafetyScore(allEvents.filter((e) => e.driverId === d.id)),
}));
---

<App title="Motoristas">
  <h2 class="text-xl font-bold text-brand-text mb-2">Motoristas</h2>
  <p class="text-sm text-brand-text-secondary mb-6">Score de seguranca calculado em tempo real a partir de eventos de telemetria.</p>
  <DriversManager client:only="react" initialDrivers={driversWithScore} />
</App>
