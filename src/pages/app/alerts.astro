---
import App from '../../layouts/App.astro';
import { getDb } from '../../db/client';
import { getAlerts, getVehicles } from '../../db/queries';
import AlertsManager from '../../components/dashboard/AlertsManager';

export const prerender = false;

const db = getDb(Astro.locals.runtime.env.DB);
const alerts = await getAlerts(db);
const vehicles = await getVehicles(db);
const vehiclesById = Object.fromEntries(vehicles.map((v) => [v.id, v]));

const alertsWithPlate = alerts.map((a) => ({
  ...a,
  vehiclePlate: vehiclesById[a.vehicleId]?.plate,
}));
---

<App title="Alertas">
  <h2 class="text-xl font-bold text-brand-text mb-2">Central de alertas</h2>
  <p class="text-sm text-brand-text-secondary mb-6">Filtre por status e severidade. Resolva alertas pendentes com um clique.</p>
  <AlertsManager client:only="react" initialAlerts={alertsWithPlate} />
</App>
