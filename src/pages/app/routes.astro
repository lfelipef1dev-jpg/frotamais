---
import App from '../../layouts/App.astro';
import { tripsData, vehiclesData, driversData } from '../../data/seed';

const vehiclesById = Object.fromEntries(vehiclesData.map(v => [v.id, v]));
const driversById = Object.fromEntries(driversData.map(d => [d.id, d]));
---

<App title="Rotas">
  <h2 class="text-xl font-bold text-brand-text mb-6">Roteirização e viagens</h2>
  <div class="bg-brand-surface rounded-xl p-6 border border-brand-border mb-6">
    <h3 class="font-bold text-brand-text mb-2">Otimizacao de rota</h3>
    <p class="text-sm text-brand-text-secondary mb-4">A proxima rota sugerida conecta 5 pontos de entrega com menor distancia estimada.</p>
    <div class="flex flex-wrap gap-2">
      <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary rounded-full text-sm font-medium">Sao Paulo</span>
      <span class="px-3 py-1 bg-brand-bg text-brand-text-secondary rounded-full text-sm">→</span>
      <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary rounded-full text-sm font-medium">Campinas</span>
      <span class="px-3 py-1 bg-brand-bg text-brand-text-secondary rounded-full text-sm">→</span>
      <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary rounded-full text-sm font-medium">Ribeirao Preto</span>
      <span class="px-3 py-1 bg-brand-bg text-brand-text-secondary rounded-full text-sm">→</span>
      <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary rounded-full text-sm font-medium">Belo Horizonte</span>
      <span class="px-3 py-1 bg-brand-bg text-brand-text-secondary rounded-full text-sm">→</span>
      <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary rounded-full text-sm font-medium">Rio de Janeiro</span>
    </div>
    <p class="text-xs text-brand-text-light mt-4">Rota calculada com Nearest Neighbor — demo.</p>
  </div>
  <div class="bg-brand-surface rounded-xl border border-brand-border overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-brand-text-secondary border-b border-brand-border bg-brand-bg">
          <th class="px-6 py-3 font-medium">Origem</th>
          <th class="px-6 py-3 font-medium">Destino</th>
          <th class="px-6 py-3 font-medium">Veiculo</th>
          <th class="px-6 py-3 font-medium">Motorista</th>
          <th class="px-6 py-3 font-medium">Status</th>
          <th class="px-6 py-3 font-medium">Distancia</th>
        </tr>
      </thead>
      <tbody>
        {tripsData.map(t => (
          <tr class="border-b border-brand-border last:border-0">
            <td class="px-6 py-3 text-brand-text-secondary">{t.startAddress}</td>
            <td class="px-6 py-3 text-brand-text-secondary">{t.endAddress}</td>
            <td class="px-6 py-3 font-medium text-brand-text">{vehiclesById[t.vehicleId]?.plate}</td>
            <td class="px-6 py-3 text-brand-text-secondary">{driversById[t.driverId]?.name}</td>
            <td class="px-6 py-3">
              <span class={`inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold ${t.status === 'completed' ? 'bg-green-100 text-green-700' : t.status === 'in_progress' ? 'bg-blue-100 text-blue-700' : t.status === 'cancelled' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-700'}`}>
                {t.status === 'completed' ? 'Concluida' : t.status === 'in_progress' ? 'Em andamento' : t.status === 'cancelled' ? 'Cancelada' : 'Agendada'}
              </span>
            </td>
            <td class="px-6 py-3 text-brand-text-secondary">{t.distanceKm ? `${t.distanceKm} km` : '-'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</App>
