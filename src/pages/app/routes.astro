---
import App from '../../layouts/App.astro';
import RoutePlanner from '../../components/dashboard/RoutePlanner';
import { getDb } from '../../db/client';
import { getTrips, getVehicles, getDrivers } from '../../db/queries';

export const prerender = false;

const db = getDb(Astro.locals.runtime.env.DB);
const trips = await getTrips(db);
const vehicles = await getVehicles(db);
const drivers = await getDrivers(db);

const vehiclesById = Object.fromEntries(vehicles.map((v) => [v.id, v]));
const driversById = Object.fromEntries(drivers.map((d) => [d.id, d]));

// Build VRP stops from completed trips' destinations
const vrpStops = trips
  .filter((t) => t.endLat != null && t.endLng != null)
  .map((t) => ({
    id: t.id,
    name: t.endAddress ?? t.id,
    lat: t.endLat!,
    lng: Number(t.endLng),
  }));

const vrpVehicles = vehicles
  .filter((v) => v.status === 'available' || v.status === 'in_use')
  .map((v) => ({ id: v.id, name: v.plate }));

const depot = {
  id: 'depot-sp',
  name: 'Deposito - Sao Paulo',
  lat: -23.5505,
  lng: -46.6333,
};
---

<App title="Rotas">
  <h2 class="text-xl font-bold text-brand-text mb-6">Roteirizacao e viagens</h2>

  <div class="bg-brand-surface rounded-xl p-6 border border-brand-border mb-6">
    <RoutePlanner
      client:only="react"
      stops={vrpStops}
      vehicles={vrpVehicles}
      depot={depot}
    />
  </div>

  <div class="bg-brand-surface rounded-xl border border-brand-border overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-brand-text-secondary border-b border-brand-border bg-brand-bg">
          <th class="px-6 py-3 font-medium">Origem</th>
          <th class="px-6 py-3 font-medium">Destino</th>
          <th class="px-6 py-3 font-medium">Veiculo</th>
          <th class="px-6 py-3 font-medium">Motorista</th>
          <th class="px-6 py-3 font-medium">Status</th>
          <th class="px-6 py-3 font-medium">Distancia</th>
        </tr>
      </thead>
      <tbody>
        {trips.map((t) => (
          <tr class="border-b border-brand-border last:border-0">
            <td class="px-6 py-3 text-brand-text-secondary">{t.startAddress}</td>
            <td class="px-6 py-3 text-brand-text-secondary">{t.endAddress}</td>
            <td class="px-6 py-3 font-medium text-brand-text">{vehiclesById[t.vehicleId]?.plate}</td>
            <td class="px-6 py-3 text-brand-text-secondary">{driversById[t.driverId]?.name}</td>
            <td class="px-6 py-3">
              <span class={`inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold ${t.status === 'completed' ? 'bg-green-100 text-green-700' : t.status === 'in_progress' ? 'bg-blue-100 text-blue-700' : t.status === 'cancelled' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-700'}`}>
                {t.status === 'completed' ? 'Concluida' : t.status === 'in_progress' ? 'Em andamento' : t.status === 'cancelled' ? 'Cancelada' : 'Agendada'}
              </span>
            </td>
            <td class="px-6 py-3 text-brand-text-secondary">{t.distanceKm ? `${t.distanceKm} km` : '-'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</App>
