---
import App from '../../layouts/App.astro';
import { getDb } from '../../db/client';
import { getFuelLogs, getVehicles } from '../../db/queries';

export const prerender = false;

const db = getDb(Astro.locals.runtime.env.DB);
const fuelLogs = await getFuelLogs(db);
const vehicles = await getVehicles(db);
const vehiclesById = Object.fromEntries(vehicles.map((v) => [v.id, v]));
const totalLiters = fuelLogs.reduce((acc, f) => acc + f.liters, 0);
const totalCost = fuelLogs.reduce((acc, f) => acc + f.cost, 0);
---

<App title="Combustível">
  <h2 class="text-2xl font-extrabold text-brand-text mb-6">Controle de combustível</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <div class="bg-white rounded-2xl p-5 border border-brand-border shadow-sm">
      <p class="text-sm text-brand-text-secondary font-medium">Total abastecido</p>
      <p class="text-2xl font-extrabold text-brand-text mt-2">{totalLiters.toFixed(1)} L</p>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-brand-border shadow-sm">
      <p class="text-sm text-brand-text-secondary font-medium">Gasto total</p>
      <p class="text-2xl font-extrabold text-brand-text mt-2">R$ {totalCost.toFixed(2)}</p>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-brand-border shadow-sm">
      <p class="text-sm text-brand-text-secondary font-medium">Preço médio/litro</p>
      <p class="text-2xl font-extrabold text-brand-text mt-2">R$ {totalLiters > 0 ? (totalCost / totalLiters).toFixed(2) : '0,00'}</p>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-brand-border shadow-sm">
      <p class="text-sm text-brand-text-secondary font-medium">Registros</p>
      <p class="text-2xl font-extrabold text-brand-text mt-2">{fuelLogs.length}</p>
    </div>
  </div>
  <div class="bg-white rounded-2xl border border-brand-border shadow-sm overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-brand-text-secondary border-b border-brand-border bg-brand-bg">
          <th class="px-6 py-3.5 font-semibold">Data</th>
          <th class="px-6 py-3.5 font-semibold">Veículo</th>
          <th class="px-6 py-3.5 font-semibold">Quilometragem</th>
          <th class="px-6 py-3.5 font-semibold">Litros</th>
          <th class="px-6 py-3.5 font-semibold">Custo</th>
          <th class="px-6 py-3.5 font-semibold">Posto</th>
        </tr>
      </thead>
      <tbody>
        {fuelLogs.map((f) => (
          <tr class="border-b border-brand-border last:border-0 hover:bg-brand-bg/30 transition">
            <td class="px-6 py-3.5 text-brand-text-secondary">{new Date(f.date).toLocaleString('pt-BR')}</td>
            <td class="px-6 py-3.5 font-semibold text-brand-text">{vehiclesById[f.vehicleId]?.plate}</td>
            <td class="px-6 py-3.5 text-brand-text-secondary">{f.odometer.toLocaleString('pt-BR')} km</td>
            <td class="px-6 py-3.5 text-brand-text-secondary">{f.liters} L</td>
            <td class="px-6 py-3.5 text-brand-text-secondary">R$ {f.cost.toFixed(2)}</td>
            <td class="px-6 py-3.5 text-brand-text-secondary">{f.station}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</App>
