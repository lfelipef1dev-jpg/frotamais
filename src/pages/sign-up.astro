---
import Layout from '../layouts/Layout.astro';
import SignUpForm from '../components/auth/SignUpForm';
import { Truck } from 'lucide-react';
---

<Layout title="Criar conta - Frotamais" noIndex={true} description="Crie uma conta de demonstração no Frotamais e explore a gestão inteligente de frotas.">
  <main id="conteudo" class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-brand-bg to-brand-surface-elevated">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 text-2xl font-extrabold text-brand-primary">
          <Truck class="w-8 h-8" aria-hidden="true" />
          Frotamais
        </a>
        <h1 class="mt-6 text-2xl font-extrabold text-brand-text">Criar conta</h1>
        <p class="mt-2 text-sm text-brand-text-secondary">
          Conta de demonstração para conhecer a plataforma.
        </p>
      </div>

      <div class="bg-white border border-brand-border rounded-2xl p-6 md:p-8 shadow-xl shadow-brand-primary/5">
        <SignUpForm client:only="react" />
      </div>

      <p class="mt-6 text-center text-sm text-brand-text-secondary">
        Já tem conta?{' '}
        <a href="/sign-in" class="text-brand-primary hover:text-brand-primary-600 font-semibold">
          Entrar no painel
        </a>
      </p>

      <p class="mt-8 text-center text-xs text-brand-text-light max-w-sm mx-auto">
        Demonstração de portfólio. Dados simulados em memória e D1. Nenhum documento fiscal real é emitido.
      </p>
    </div>
  </main>
</Layout>
