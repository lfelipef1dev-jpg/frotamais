---
import Layout from '../layouts/Layout.astro';
import SignInForm from '../components/auth/SignInForm';
---

<Layout title="Entrar - Frotamais">
  <main id="conteudo" class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-block text-2xl font-bold text-brand-text">Frotamais</a>
        <h1 class="mt-4 text-2xl font-bold text-brand-text">Entrar no painel</h1>
        <p class="mt-2 text-sm text-brand-text-secondary">
          Acesso a area logada da demonstracao de gestao de frotas.
        </p>
      </div>

      <div class="bg-brand-surface border border-brand-border rounded-xl p-6 md:p-8">
        <SignInForm client:only="react" />
      </div>

      <p class="mt-6 text-center text-sm text-brand-text-secondary">
        Nao tem conta?{' '}
        <a href="/sign-up" class="text-brand-accent hover:text-brand-accent-hover font-medium">
          Criar conta de demonstracao
        </a>
      </p>

      <p class="mt-8 text-center text-xs text-brand-text-secondary max-w-sm mx-auto">
        Demonstracao de portofolio. Dados simulados em memoria e D1. Nenhum documento fiscal real e emitido.
      </p>
    </div>
  </main>
</Layout>
