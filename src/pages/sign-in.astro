---
import Layout from '../layouts/Layout.astro';
import SignInForm from '../components/auth/SignInForm';
import Logo from '../components/Logo.astro';
---

<Layout title="Entrar - Frotamais" noIndex={true} description="Acesse o painel de demonstração do Frotamais e explore a gestão inteligente de frotas.">
  <main id="conteudo" class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-brand-bg to-brand-surface-elevated">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex" aria-label="Frotamais — página inicial">
          <Logo size={38} />
        </a>
        <h1 class="mt-6 text-2xl font-extrabold text-brand-text">Entrar no painel</h1>
        <p class="mt-2 text-sm text-brand-text-secondary">
          Acesso à área logada da demonstração de gestão de frotas.
        </p>
      </div>

      <div class="bg-white border border-brand-border rounded-2xl p-6 md:p-8 shadow-xl shadow-brand-primary/5">
        <SignInForm client:only="react" />
      </div>

      <p class="mt-6 text-center text-sm text-brand-text-secondary">
        Não tem conta?{' '}
        <a href="/sign-up" class="text-brand-primary hover:text-brand-primary-600 font-semibold">
          Criar conta de demonstração
        </a>
      </p>

      <p class="mt-8 text-center text-xs text-brand-text-light max-w-sm mx-auto">
        Demonstração de portfólio. Dados simulados em memória e D1. Nenhum documento fiscal real é emitido.
      </p>
    </div>
  </main>
</Layout>
