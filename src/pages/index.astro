---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, Truck, Route, Fuel, Shield, Wrench, FileText } from 'lucide-react';

const features = [
  { icon: Truck, title: 'Rastreamento em tempo real', description: 'Acompanhe cada veículo da frota em um mapa ao vivo com atualizações de localização.' },
  { icon: Route, title: 'Roteirização inteligente', description: 'Otimize rotas com algoritmos que reduzem quilometragem e tempo de entrega.' },
  { icon: Fuel, title: 'Controle de combustível', description: 'Registre abastecimentos e identifique anomalias no consumo por veículo.' },
  { icon: Shield, title: 'Score de segurança', description: 'Análise de eventos de direção para treinar motoristas e reduzir riscos.' },
  { icon: Wrench, title: 'Manutenção preventiva', description: 'Cronograma automático por km, dias ou horas de uso, com alertas de vencimento.' },
  { icon: FileText, title: 'Documentação e compliance', description: 'Centralize CNH, seguros, licenciamento e vencimentos em um só lugar.' },
];
---

<Layout title="Frotamais - Gerenciador Inteligente de Frotas">
  <header class="bg-brand-surface border-b border-brand-border sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 md:px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-extrabold text-xl text-brand-primary">
        <Truck className="w-7 h-7" aria-hidden="true" />
        Frotamais
      </a>
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="#funcionalidades" class="text-brand-text-secondary hover:text-brand-text">Funcionalidades</a>
        <a href="#como-funciona" class="text-brand-text-secondary hover:text-brand-text">Como funciona</a>
        <a href="#precos" class="text-brand-text-secondary hover:text-brand-text">Preços</a>
      </nav>
      <a href="/sign-in" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-primary text-white rounded-lg font-semibold hover:bg-brand-primary-600 transition">Acessar demo <ArrowRight className="w-4 h-4" aria-hidden="true" /></a>
    </div>
  </header>

  <main id="conteudo">
    <section class="relative min-h-[80vh] flex items-center overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <picture>
          <source
            srcset="/img/hero-frotamais-480.webp 480w,
                    /img/hero-frotamais-640.webp 640w,
                    /img/hero-frotamais-768.webp 768w,
                    /img/hero-frotamais-1024.webp 1024w,
                    /img/hero-frotamais-1440.webp 1440w,
                    /img/hero-frotamais-1920.webp 1920w,
                    /img/hero-frotamais-3840.webp 3840w"
            sizes="(max-width: 640px) 100vw, (max-width: 768px) 100vw, (max-width: 1024px) 100vw, (max-width: 1440px) 100vw, 100vw"
            type="image/webp"
          />
          <img
            src="/img/hero-frotamais.png"
            alt="Frota de veículos comerciais modernos em ambiente urbano, representando gestão de frotas e telemetria"
            class="w-full h-full object-cover"
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-r from-brand-primary/90 via-brand-primary/70 to-transparent"></div>
      </div>
      <div class="relative max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
        <div class="max-w-2xl">
          <span class="inline-block bg-white/10 backdrop-blur-sm text-white/90 font-semibold text-sm uppercase tracking-wider px-3 py-1 rounded-full mb-6">Sua frota, sem planilhas</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight text-white mt-4 drop-shadow-sm">Visibilidade total da sua frota em uma única plataforma</h1>
          <p class="text-lg md:text-xl text-white/90 mt-6 max-w-xl leading-relaxed">Rastreamento, manutenção, combustível, documentos e rotas. Tudo integrado para você tomar decisões com confiança e reduzir custos.</p>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/sign-in" class="px-6 py-3 bg-white text-brand-primary rounded-lg font-semibold hover:bg-brand-surface transition shadow-lg">Ver demo da plataforma</a>
            <a href="#funcionalidades" class="px-6 py-3 border-2 border-white/40 text-white rounded-lg font-semibold hover:bg-white/10 transition">Conhecer funcionalidades</a>
          </div>
          <div class="flex flex-wrap gap-6 md:gap-8 mt-10 text-sm">
            <div><strong class="block text-2xl md:text-3xl text-white">+35%</strong><span class="text-white/80">eficiência estimada</span></div>
            <div><strong class="block text-2xl md:text-3xl text-white">-60%</strong><span class="text-white/80">atrasos em piloto</span></div>
            <div><strong class="block text-2xl md:text-3xl text-white">12K</strong><span class="text-white/80">economia mensal (alvo)</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="funcionalidades" class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-4xl font-bold text-brand-text">Tudo que sua operação precisa</h2>
          <p class="text-brand-text-secondary mt-4 max-w-2xl mx-auto">Módulos integrados para gestão completa da frota, do rastreamento até a manutenção preditiva.</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f) => (
            <div class="bg-brand-surface rounded-xl p-6 border border-brand-border hover:shadow-lg transition">
              <div class="w-12 h-12 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-4">
                <f.icon className="w-6 h-6" aria-hidden="true" />
              </div>
              <h3 class="text-lg font-bold text-brand-text">{f.title}</h3>
              <p class="text-brand-text-secondary mt-2 text-sm">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="como-funciona" class="py-16 md:py-20 bg-brand-surface-elevated">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-text text-center mb-14">Como funciona</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-12 h-12 mx-auto rounded-full bg-brand-primary text-white flex items-center justify-center font-bold text-lg">1</div>
            <h3 class="font-bold mt-4">Conecte a frota</h3>
            <p class="text-brand-text-secondary mt-2 text-sm">Cadastre veículos, motoristas e dados dos ativos em minutos.</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto rounded-full bg-brand-primary text-white flex items-center justify-center font-bold text-lg">2</div>
            <h3 class="font-bold mt-4">Monitore operações</h3>
            <p class="text-brand-text-secondary mt-2 text-sm">Acompanhe rotas, alertas, combustível e manutenção em tempo real.</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto rounded-full bg-brand-primary text-white flex items-center justify-center font-bold text-lg">3</div>
            <h3 class="font-bold mt-4">Decida com dados</h3>
            <p class="text-brand-text-secondary mt-2 text-sm">Relatórios de TCO, consumo e segurança apontam onde otimizar.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="precos" class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-text text-center mb-14">Planos</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-brand-surface rounded-xl p-6 border border-brand-border">
            <h3 class="font-bold text-lg">Essencial</h3>
            <p class="text-brand-text-secondary text-sm">Para frotas pequenas</p>
            <div class="text-3xl font-extrabold my-4">R$ 0</div>
            <ul class="text-sm text-brand-text-secondary space-y-2">
              <li>Até 5 veículos</li>
              <li>Rastreamento básico</li>
              <li>Relatórios simples</li>
            </ul>
          </div>
          <div class="bg-brand-surface rounded-xl p-6 border-2 border-brand-primary relative">
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-primary text-white text-xs font-bold px-3 py-1 rounded-full">Mais popular</span>
            <h3 class="font-bold text-lg">Pro</h3>
            <p class="text-brand-text-secondary text-sm">Para operações em crescimento</p>
            <div class="text-3xl font-extrabold my-4">R$ 0</div>
            <ul class="text-sm text-brand-text-secondary space-y-2">
              <li>Até 50 veículos</li>
              <li>Roteirização e geofencing</li>
              <li>Manutenção preventiva</li>
            </ul>
          </div>
          <div class="bg-brand-surface rounded-xl p-6 border border-brand-border">
            <h3 class="font-bold text-lg">Enterprise</h3>
            <p class="text-brand-text-secondary text-sm">Para grandes transportadoras</p>
            <div class="text-3xl font-extrabold my-4">R$ 0</div>
            <ul class="text-sm text-brand-text-secondary space-y-2">
              <li>Frota ilimitada</li>
              <li>API e integrações</li>
              <li>Suporte dedicado</li>
            </ul>
          </div>
        </div>
        <p class="text-center text-brand-text-light text-sm mt-8">Valores simulados para demonstração. Não representam oferta comercial.</p>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-brand-primary text-white">
      <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold">Pronto para testar a demo?</h2>
        <p class="text-white/80 mt-4">Acesse o painel com dados simulados e veja a plataforma em ação.</p>
        <a href="/sign-in" class="inline-flex items-center gap-2 mt-8 px-8 py-4 bg-white text-brand-primary rounded-lg font-bold hover:bg-brand-bg transition">Acessar demo <ArrowRight className="w-5 h-5" aria-hidden="true" /></a>
      </div>
    </section>
  </main>

  <footer class="bg-brand-surface border-t border-brand-border py-10">
    <div class="max-w-6xl mx-auto px-4 md:px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-brand-text-secondary">
      <p>&copy; 2026 Frotamais. Projeto de portfólio ExpoStacker.</p>
      <p>Dados ilustrativos. Sem fins comerciais.</p>
    </div>
  </footer>
</Layout>
