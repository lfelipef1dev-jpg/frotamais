{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frotamais",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frotamais-db",
      "database_id": "e1de1d27-f438-4f52-973d-f0ca033da582",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8f7da78dc7fd4f95b2d11c81f1161f80"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FLEET_TRACKER",
        "class_name": "FleetTracker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FleetTracker"]
    }
  ]
}
